# Copy to .env and adjust.  `cp .env.example .env`

# ---- App ----
# dev | test | prod   (debug info is exposed in dev/test only)
APP_ENV=dev
LOG_LEVEL=INFO

# ---- LLM ----
# Primary provider + comma-separated fallbacks, tried in order.
# Options: groq | ollama | fake
LLM_PROVIDER=ollama
LLM_FALLBACKS=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Free API key from console.groq.com (leave empty if not used)
GROQ_API_KEY=

# Model names
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_BASE=http://ollama:11434

# ---- RAG ----
# ollama | fake (fake = deterministic hash vectors, not semantic)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=4
RAG_MIN_SCORE=0.55
RAG_SCORE_MARGIN=0.05

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=120
# Fixed "today" for return-window checks (keeps demo data returnable); delete line = real clock
BUSINESS_DATE=2026-09-10T12:00:00

# ---- Guardrails ----
# groq = Llama Prompt Guard 2 classifier (free on Groq) on top of regex rules | off
GUARDRAIL_CLASSIFIER=groq
GUARDRAIL_INJECTION_THRESHOLD=0.8

# ---- Production ----
# Chat messages per user (or IP) per minute; 0 disables (e.g. for eval runs)
RATE_LIMIT_PER_MINUTE=20
# LLM tracing: free account at https://cloud.langfuse.com (leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Memory ----
CHAT_HISTORY_TURNS=10
CHAT_SESSION_TTL_SECONDS=86400

# ---- Data (host ports) ----
POSTGRES_USER=shopbot
POSTGRES_PASSWORD=shopbot
POSTGRES_DB=shopbot
